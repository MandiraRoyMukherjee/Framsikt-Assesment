  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "next": "^14.2.35",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
