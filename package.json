{
  "name": "snack-counter-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Snack Counter Automation - refill lifecycle, volunteer selection and budget control (Framsikt assessment)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
