# Copy to .env (never commit .env). Needed ONLY for the Neon Postgres path; the default demo and tests use mock data.
# Neon dashboard -> Connection Details -> copy the pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional: LLM features (receipt cross-check + monthly summary). Without a key the app uses deterministic fallbacks.
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, Ollama, vLLM, or a gateway exposing /chat/completions).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
